{
  "name": "pi-caido",
  "version": "1.0.3",
  "description": "Pi Coding Agent extension to route traffic through Caido web proxy and consume Caido MCP tools",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "skills",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "pi",
    "caido",
    "mcp",
    "model-context-protocol",
    "web-security",
    "proxy",
    "pentest",
    "appsec"
  ],
  "author": "KanyCrew",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KanyCrew/pi-caido.git"
  },
  "bugs": {
    "url": "https://github.com/KanyCrew/pi-caido/issues"
  },
  "homepage": "https://github.com/KanyCrew/pi-caido#readme",
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/KanyCrew/pi-caido/main/assets/preview.png"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "prepack": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^22.13.0",
    "tsup": "^8.3.6",
    "typebox": "^1.1.38",
    "typescript": "^5.7.3"
  }
}
